# Base path/URL the Axios API client sends requests to. Read at build time —
# set this correctly BEFORE running `npm run build` for a given environment.
#
# Default (relative path): works in dev via the proxy below, and in
# production IF the frontend and backend are served from the same origin
# behind a reverse proxy that routes /api/* to the backend. No backend
# changes needed — this is the recommended production setup.
#
# Full URL (e.g. https://api.your-domain.com/api/v1): only works if the
# backend has CORS enabled for the frontend's origin. It currently does not —
# see the root README's "Frontend" section before using this.
VITE_API_BASE_URL=/api/v1

# Dev-server-only: where the Vite proxy forwards "/api" requests to (see
# vite.config.ts). Not read by the app itself, and not used in production
# builds — only by `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080
