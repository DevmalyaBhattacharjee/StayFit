# Base path/URL the Axios API client sends requests to.
# Kept as a relative path in dev so the Vite dev server proxy (below) forwards
# it to the backend, since the backend has no CORS configuration of its own.
# For a standalone production build, point this at the full backend origin
# instead, e.g. https://api.your-domain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Dev-server-only: where the Vite proxy forwards "/api" requests to (see
# vite.config.ts). Not read by the app itself, and not used in production
# builds — only by `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080
